# Copia a .env para desarrollo local (opcional)
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Producción (Render → Environment):
# PORT lo asigna Render automáticamente; no hace falta definirlo
# URL exacta de Vercel (Domains o la que uses en el navegador):
# FRONTEND_ORIGIN=https://graphql-sistema-de-votos-h2ax.vercel.app
# Varias URLs (producción + previews), separadas por coma:
# FRONTEND_ORIGIN=https://tu-app.vercel.app,https://tu-app-git-main-usuario.vercel.app
