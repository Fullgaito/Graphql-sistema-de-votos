# Copia a .env.local para desarrollo local (opcional; los valores por defecto apuntan a localhost)
VITE_GRAPHQL_HTTP=http://localhost:4000/graphql
VITE_GRAPHQL_WS=ws://localhost:4000/graphql

# Producción (Vercel → Settings → Environment Variables):
# VITE_GRAPHQL_HTTP=https://tu-backend.onrender.com/graphql
# VITE_GRAPHQL_WS=wss://tu-backend.onrender.com/graphql
